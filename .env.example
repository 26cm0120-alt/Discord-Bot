# Local development only. For VPS deployment, use GitHub Actions Secret DISCORD_TOKEN.
DISCORD_TOKEN=replace_me
CLIENT_ID=replace_me
GUILD_ID=replace_me

# Comma-separated text channel IDs whose messages are read aloud.
# A voice channel's built-in chat uses that voice channel's own ID.
TEXT_CHANNEL_IDS=replace_with_channel_id_1,replace_with_channel_id_2

# VOICEVOX Engine address. Keep it bound to localhost for a single-machine setup.
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=1
ANNOUNCE_VOICE_EVENTS=true
LINK_SPEECH_MODE=omit
TTS_PLAYBACK_VOLUME=0.65 # 0.0–1.0; lower is quieter

# Supiki mode can use the existing VOICEVOX preset or local GPT-SoVITS reference-audio inference.
SUPIKI_TTS_PROVIDER=voicevox
SUPIKI_SPEAKER_ID=1
SUPIKI_SPEED_SCALE=1.12
SUPIKI_PITCH_SCALE=0.08
SUPIKI_INTONATION_SCALE=1.2

# Local testing: http://127.0.0.1:9880. For split VPS/PC hosting, use the PC's
# private Tailscale Serve address; never expose port 9880 to the public internet.
GPT_SOVITS_URL=http://127.0.0.1:9880
# This path is opened by GPT-SoVITS, so set a path on the machine running its API.
GPT_SOVITS_REF_AUDIO_PATH=
GPT_SOVITS_REF_TEXT=
# Optional language-specific references; these take precedence over the legacy pair above.
GPT_SOVITS_REF_AUDIO_PATH_JA=
GPT_SOVITS_REF_TEXT_JA=
GPT_SOVITS_REF_AUDIO_PATH_KO=
GPT_SOVITS_REF_TEXT_KO=
# Optional numbered prompt pairs rotate in ascending order, for example:
# GPT_SOVITS_REF_AUDIO_PATH_JA_1=C:/path/to/ja-01.wav
# GPT_SOVITS_REF_TEXT_JA_1=Exact Japanese transcript for ja-01.wav
# GPT_SOVITS_REF_AUDIO_PATH_JA_2=C:/path/to/ja-02.wav
# GPT_SOVITS_REF_TEXT_JA_2=Exact Japanese transcript for ja-02.wav
# Reference audio language (ja/ko/en/etc.) and target text language (auto supports mixed languages).
GPT_SOVITS_PROMPT_LANG=ja
GPT_SOVITS_TEXT_LANG=auto
GPT_SOVITS_TIMEOUT_MS=60000
GPT_SOVITS_PROMPT_FREE=false # true omits prompt transcript to prevent it being echoed

# Safety / latency controls
MAX_MESSAGE_CHARS=240
MAX_QUEUE_ITEMS=30
VOICE_READY_TIMEOUT_MS=15000


